+
+/** The outcome of sending a draft invoice, as one line. */
+export async function sendResult(invoiceId: number): Promise<string> {
+  const r = await rpc<Invoice>('sendInvoice', [invoiceId]);
+  if (!r.ok) return 'error: ' + r.error;
+  return `Invoice #${r.value.id} sent on ${r.value.sentOn}`;
+}
