@@ -103,3 +103,12 @@
   if (c.email === '') return err('customer has no email address');
   return ok(undefined);
 }
+
+/** A draft invoice as it would be once sent, if it is complete enough to send. The app stores nothing. */
+export function sendInvoice(id: InvoiceId): Result<Invoice, string> {
+  const inv = findInvoice(id);
+  if (inv === null) return err('no such invoice');
+  const ready = readyToSend(inv);
+  if (!ready.ok) return ready;
+  return transition(inv, 'sent');
+}
