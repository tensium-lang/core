+
+// ---- sending a draft invoice
+
+server fn sendInvoice(id: InvoiceId): Result<Invoice, string> {
+  let inv = findInvoice(id);
+  if (inv === null) { return err("no such invoice"); }
+  match readyToSend(inv) {
+    ok(ready) => { return transition(inv, Status.Sent); }
+    err(e) => { return err(e); }
+  }
+}
+
+client fn sendResult(invoiceId: InvoiceId): string {
+  match sendInvoice(invoiceId) {
+    ok(inv) => {
+      let sentOn = inv.sentOn;
+      if (sentOn === null) { return "Invoice #" + str(inv.id.value) + " sent"; }
+      return "Invoice #" + str(inv.id.value) + " sent on " + sentOn;
+    }
+    err(e) => { return "error: " + e; }
+  }
+}
