+/// The outcome of sending a draft invoice, as one line.
+pub fn send_result(invoice_id: i64) -> String {
+    match rpc::<Invoice>("sendInvoice", &[json!(invoice_id)]) {
+        Ok(inv) => format!("Invoice #{} sent on {}", inv.id.0, inv.sent_on.unwrap_or_default()),
+        Err(e) => format!("error: {}", e),
+    }
+}
