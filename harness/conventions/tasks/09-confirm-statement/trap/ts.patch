+
+export type StatementConfirmation = { customerId: CustomerId; outstandingCents: Cents };
+
+/** The customer's outstanding total, worked out here and compared with what the client showed. */
+export function confirmStatement(customerId: CustomerId, outstandingCents: Cents): Result<StatementConfirmation, string> {
