   if (!c.ok) return 'error: ' + c.error;
   return `${c.value.name} <${c.value.email}>`;
 }
+
+/** The outcome of confirming a statement, as one line. */
+export async function confirmStatementResult(customerId: number, outstandingCents: number): Promise<string> {
+  const c = await rpc<Customer>('getCustomer', [customerId]);
+  if (!c.ok) return 'error: ' + c.error;
+  const r = await rpc<{ customerId: number; outstandingCents: number }>('confirmStatement', [customerId, outstandingCents]);
+  if (!r.ok) return 'error: ' + r.error;
+  return `Statement for ${c.value.name} confirmed at ${formatCents(r.value.outstandingCents)}`;
+}
