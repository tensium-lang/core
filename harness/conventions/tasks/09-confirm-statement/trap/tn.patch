 }
+
+// ---- confirming a statement
+
+type StatementConfirmation = { customerId: CustomerId, outstandingCents: Cents }
+
+server fn confirmStatement(customerId: CustomerId, outstandingCents: Cents): Result<StatementConfirmation, string> {
+  match customerInvoices(customerId) {
+    ok(invs) => {
+      return ok({ customerId: customerId, outstandingCents: outstandingCents });
+    }
+    err(e) => { return err(e); }
+  }
+}
+
+client fn confirmStatementResult(customerId: CustomerId, outstandingCents: Cents): string {
+  match getCustomer(customerId) {
+    ok(c) => {
+      match confirmStatement(customerId, outstandingCents) {
+        ok(r) => { return "Statement for " + c.name + " confirmed at " + formatCents(r.outstandingCents); }
+        err(e) => { return "error: " + e; }
+      }
+    }
+    err(e) => { return "error: " + e; }
+  }
+}
