 /// True when the invoice exists and belongs to the customer.
 pub fn invoice_belongs_to(invoice_id: InvoiceId, customer_id: CustomerId) -> bool {
     find_invoice(invoice_id).map(|inv| inv.customer_id == customer_id).unwrap_or(false)
+}
+
+#[derive(serde::Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct StatementConfirmation {
+    pub customer_id: CustomerId,
+    pub outstanding_cents: Cents,
+}
+
+/// The customer's outstanding total, worked out here and compared with what the client showed.
+pub fn confirm_statement(customer_id: CustomerId, outstanding_cents: Cents) -> Result<StatementConfirmation, String> {
+    let mut owed = Cents(0);
+    for inv in customer_invoices(customer_id)? {
+        if inv.status() == Status::Sent {
+            owed = add(owed, totals_of(&inv).balance_cents);
+        }
+    }
+    if owed != outstanding_cents {
+        return Err(format!("outstanding has changed: expected {}", format_cents(owed)));
+    }
+    Ok(StatementConfirmation { customer_id, outstanding_cents: owed })
 }
