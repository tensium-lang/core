+        Err(e) => return format!("error: {}", e),
+    };
+    match rpc::<StatementConfirmation>("confirmStatement", &[json!(customer_id), json!(outstanding_cents)]) {
+        Ok(r) => format!("Statement for {} confirmed at {}", c.name, format_cents(r.outstanding_cents)),
+        Err(e) => format!("error: {}", e),
