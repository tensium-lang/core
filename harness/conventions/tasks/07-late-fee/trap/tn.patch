+
+// ---- late fees
+
+type LateFee = { invoiceId: InvoiceId, periods: number, feeCents: Cents }
+
+server fn lateFee(id: InvoiceId): Result<LateFee, string> {
+  let inv = findInvoice(id);
+  if (inv === null) { return err("no such invoice"); }
+  match daysOverdue(inv) {
+    ok(late) => {
+      let periods = floor(late / 30);
+      let fee = if (periods == 0) { Cents(0) } else { Cents(floor(totalsOf(inv).balanceCents.value * 0.015 * periods + 0.5)) };
+      return ok({ invoiceId: inv.id, periods: periods, feeCents: fee });
+    }
+    err(e) => { return err(e); }
+  }
+}
+
+client fn lateFeeLine(invoiceId: InvoiceId): string {
+  match lateFee(invoiceId) {
+    ok(f) => {
+      if (f.periods == 0) { return "No late fee for #" + str(f.invoiceId.value); }
+      let unit = if (f.periods == 1) { " period)" } else { " periods)" };
+      return "Late fee for #" + str(f.invoiceId.value) + ": " + formatCents(f.feeCents) + " (" + str(f.periods) + unit;
+    }
+    err(e) => { return "error: " + e; }
+  }
+}
