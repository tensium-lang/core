+#[derive(serde::Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct LateFee {
+    pub invoice_id: InvoiceId,
+    pub periods: i64,
+    pub fee_cents: Cents,
+}
+
+/// 1.5 % of the balance for each full 30-day period past due.
+pub fn late_fee(id: InvoiceId) -> Result<LateFee, String> {
+    let inv = get_invoice(id)?;
+    let periods = days_overdue(&inv)? / 30;
+    let fee_cents = if periods == 0 { Cents(0) } else { Cents((totals_of(&inv).balance_cents.0 as f64 * 0.015 * periods as f64).round() as i64) };
+    Ok(LateFee { invoice_id: inv.id, periods, fee_cents })
+}
