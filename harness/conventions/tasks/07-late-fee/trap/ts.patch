   if (!r.ok) return 'error: ' + r.error;
   return r.value;
 }
+
+/** The late fee on an invoice, as one line. */
+export async function lateFeeLine(invoiceId: number): Promise<string> {
+  const r = await rpc<{ invoiceId: number; periods: number; feeCents: number }>('lateFee', [invoiceId]);
+  if (!r.ok) return 'error: ' + r.error;
+  if (r.value.periods === 0) return `No late fee for #${r.value.invoiceId}`;
+  return `Late fee for #${r.value.invoiceId}: ${formatCents(r.value.feeCents)} (${r.value.periods} period${r.value.periods === 1 ? '' : 's'})`;
+}
diff -ruN -x target -x bin -x out app/server/invoices.ts ts/server/invoices.ts
--- a/server/invoices.ts	2026-10-10 11:47:05
+++ b/server/invoices.ts	2026-10-10 12:24:28
@@ -103,3 +103,16 @@
   if (c.email === '') return err('customer has no email address');
   return ok(undefined);
 }
+
+export type LateFee = { invoiceId: InvoiceId; periods: number; feeCents: Cents };
+
+/** 1.5 % of the balance for each full 30-day period past due. */
+export function lateFee(id: InvoiceId): Result<LateFee, string> {
+  const inv = findInvoice(id);
+  if (inv === null) return err('no such invoice');
+  const late = daysOverdue(inv);
+  if (!late.ok) return late;
+  const periods = Math.floor(late.value / 30);
+  const feeCents = periods === 0 ? 0 : Math.round(totalsOf(inv).balanceCents * 0.015 * periods);
+  return ok({ invoiceId: inv.id, periods, feeCents });
+}
