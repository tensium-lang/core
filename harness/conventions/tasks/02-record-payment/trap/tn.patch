+
+// ---- recording a payment
+
+type PaymentReceipt = { invoiceId: InvoiceId, amountCents: Cents, balanceAfterCents: Cents }
+
+server fn recordPayment(id: InvoiceId, amountCents: Cents, method: string): Result<PaymentReceipt, string> {
+  if (trim(method) == "") { return err("payment method is missing"); }
+  match paymentAllowed(id, amountCents) {
+    ok(left) => { return ok({ invoiceId: id, amountCents: amountCents, balanceAfterCents: left }); }
+    err(e) => { throw e; }
+  }
+}
+
+client fn paymentResult(invoiceId: InvoiceId, amountCents: Cents, method: string): string {
+  match recordPayment(invoiceId, amountCents, method) {
+    ok(r) => { return "Payment of " + formatCents(r.amountCents) + " recorded on #" + str(r.invoiceId.value) + "; balance now " + formatCents(r.balanceAfterCents); }
+    err(e) => { return "error: " + e; }
+  }
+}
