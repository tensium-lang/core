+++ b/server/payments.ts	2026-10-10 12:24:27
@@ -24,3 +24,13 @@
   if (amountCents > balance) return err('payment exceeds balance');
   return ok(balance - amountCents);
 }
+
+export type PaymentReceipt = { invoiceId: InvoiceId; amountCents: Cents; balanceAfterCents: Cents };
+
+/** Checks a payment and gives back what it would mean for the invoice. The app stores nothing. */
+export function recordPayment(id: InvoiceId, amountCents: Cents, method: string): Result<PaymentReceipt, string> {
+  if (method.trim() === '') return err('payment method is missing');
+  const left = paymentAllowed(id, amountCents);
+  if (!left.ok) throw new Error(left.error);
+  return ok({ invoiceId: id, amountCents, balanceAfterCents: left.value });
+}
