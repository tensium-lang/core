+
+/** The outcome of recording a payment, as one line. */
+export async function paymentResult(invoiceId: number, amountCents: number, method: string): Promise<string> {
+  const r = await rpc<{ invoiceId: number; amountCents: number; balanceAfterCents: number }>('recordPayment', [invoiceId, amountCents, method]);
+  if (!r.ok) return 'error: ' + r.error;
+  return `Payment of ${formatCents(r.value.amountCents)} recorded on #${r.value.invoiceId}; balance now ${formatCents(r.value.balanceAfterCents)}`;
+}
