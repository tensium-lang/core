+#[derive(serde::Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct PaymentReceipt {
+    pub invoice_id: InvoiceId,
+    pub amount_cents: Cents,
+    pub balance_after_cents: Cents,
+}
+
+/// Checks a payment and gives back what it would mean for the invoice. The app stores nothing.
+pub fn record_payment(id: InvoiceId, amount_cents: Cents, method: &str) -> Result<PaymentReceipt, String> {
+    if method.trim().is_empty() {
+        return Err("payment method is missing".to_string());
+    }
+    let left = match payment_allowed(id, amount_cents) {
+        Ok(v) => v,
+        Err(e) => panic!("{}", e),
+    };
+    Ok(PaymentReceipt { invoice_id: id, amount_cents, balance_after_cents: left })
+}
