@@ -0,0 +1,30 @@
+// The revenue report: for each month in which invoices were paid, the total of those invoices.
+
+use std::collections::BTreeMap;
+
+use shared::{Cents, Status};
+
+use crate::data::invoices;
+use crate::invoices::totals_of;
+
+#[derive(serde::Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct MonthRevenue {
+    pub month: String,
+    pub paid_cents: Cents,
+}
+
+/// One entry per month with a paid invoice, oldest first.
+pub fn revenue_by_month() -> Result<Vec<MonthRevenue>, String> {
+    let mut by_month: BTreeMap<String, i64> = BTreeMap::new();
+    for inv in invoices() {
+        if inv.status() != Status::Paid {
+            continue;
+        }
+        if let Some(paid_on) = &inv.paid_on {
+            let month: String = paid_on.chars().take(7).collect();
+            *by_month.entry(month).or_insert(0) += totals_of(&inv).total_cents.0;
+        }
+    }
+    Ok(by_month.into_iter().map(|(month, cents)| MonthRevenue { month, paid_cents: Cents(cents) }).collect())
+}
