@@ -0,0 +1,20 @@
+// The revenue screen: one line per month with the money paid in it.
+
+use shared::Cents;
+
+use crate::format::format_cents;
+use crate::rpc::rpc;
+
+#[derive(serde::Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct MonthRevenue {
+    month: String,
+    paid_cents: Cents,
+}
+
+pub fn revenue_view() -> String {
+    match rpc::<Vec<MonthRevenue>>("revenueByMonth", &[]) {
+        Ok(ms) => ms.iter().map(|m| format!("{}: {}", m.month, format_cents(m.paid_cents))).collect::<Vec<_>>().join("\n"),
+        Err(e) => format!("error: {}", e),
+    }
+}
