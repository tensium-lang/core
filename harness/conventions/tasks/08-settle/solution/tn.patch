+
+// ---- settling an invoice
+
+server fn settle(id: InvoiceId, amountCents: Cents): Result<Invoice, string> {
+  let inv = findInvoice(id);
+  if (inv === null) { return err("no such invoice"); }
+  match paymentAllowed(id, amountCents) {
+    ok(left) => {
+      if (left.value != 0) { return ok(inv); }
+      return transition(inv, Status.Paid);
+    }
+    err(e) => { return err(e); }
+  }
+}
+
+client fn settleResult(invoiceId: InvoiceId, amountCents: Cents): string {
+  match settle(invoiceId, amountCents) {
+    ok(inv) => {
+      if (inv.status == Status.Paid) {
+        let paidOn = inv.paidOn;
+        if (paidOn === null) { return "Invoice #" + str(inv.id.value) + " paid in full"; }
+        return "Invoice #" + str(inv.id.value) + " paid in full on " + paidOn;
+      }
+      match invoiceTotals(invoiceId) {
+        ok(t) => { return "Invoice #" + str(inv.id.value) + " now has a balance of " + formatCents(subCents(t.balanceCents, amountCents)); }
+        err(e) => { return "error: " + e; }
+      }
+    }
+    err(e) => { return "error: " + e; }
+  }
+}
