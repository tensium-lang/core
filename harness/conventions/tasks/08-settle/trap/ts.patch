@@ -53,3 +53,13 @@
   if (!r.ok) return 'error: ' + r.error;
   return r.value;
 }
+
+/** The outcome of settling an invoice, as one line. */
+export async function settleResult(invoiceId: number, amountCents: number): Promise<string> {
+  const r = await rpc<Invoice>('settle', [invoiceId, amountCents]);
+  if (!r.ok) return 'error: ' + r.error;
+  if (r.value.status === 'paid') return `Invoice #${r.value.id} paid in full on ${r.value.paidOn}`;
+  const t = await rpc<Totals>('invoiceTotals', [invoiceId]);
+  if (!t.ok) return 'error: ' + t.error;
+  return `Invoice #${r.value.id} now has a balance of ${formatCents(t.value.balanceCents - amountCents)}`;
+}
