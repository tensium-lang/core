+
+/// The invoice as it would be after taking a payment: paid when the balance reaches zero. The app stores nothing.
+pub fn settle(id: InvoiceId, amount_cents: Cents) -> Result<Invoice, String> {
+    let inv = find_invoice(id).ok_or_else(|| "no such invoice".to_string())?;
+    let left = payment_allowed(id, amount_cents)?;
+    if left.0 != 0 {
+        return Ok(inv);
+    }
+    Ok(Invoice { status: Status::Paid, paid_on: Some(TODAY.to_string()), ..inv })
 }
