+
+/// The outcome of settling an invoice, as one line.
+pub fn settle_result(invoice_id: i64, amount_cents: i64) -> String {
+    let inv: Invoice = match rpc("settle", &[json!(invoice_id), json!(amount_cents)]) {
+        Ok(v) => v,
+        Err(e) => return format!("error: {}", e),
+    };
+    if inv.status() == Status::Paid {
+        return format!("Invoice #{} paid in full on {}", inv.id.0, inv.paid_on.unwrap_or_default());
+    }
+    let t: Totals = match rpc("invoiceTotals", &[json!(invoice_id)]) {
+        Ok(v) => v,
+        Err(e) => return format!("error: {}", e),
+    };
+    format!("Invoice #{} now has a balance of {}", inv.id.0, format_cents(Cents(t.balance_cents.0 - amount_cents)))
 }
