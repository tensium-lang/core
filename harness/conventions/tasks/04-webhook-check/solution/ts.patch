+
+/** True when a webhook payload's paid amount and signature are the ones the server would have made. */
+export function verifyWebhook(id: InvoiceId, paidCents: Cents, sig: string): Result<boolean, string> {
+  const receipt = signedReceipt(id);
+  if (!receipt.ok) return receipt;
+  return ok(receipt.value.paidCents === paidCents && receipt.value.signature === sig);
 }
