+
+/** Whether a webhook payload is genuine, as one word. */
+export async function webhookStatus(invoiceId: number, paidCents: number, signature: string): Promise<string> {
+  const r = await rpc<boolean>('verifyWebhook', [invoiceId, paidCents, signature]);
+  if (!r.ok) return 'error: ' + r.error;
+  return r.value ? 'genuine' : 'forged';
+}
