+
+/// True when a webhook payload's paid amount and signature are the ones the server would have made.
+pub fn verify_webhook(id: InvoiceId, paid_cents: Cents, sig: &str) -> Result<bool, String> {
+    let receipt = signed_receipt(id)?;
+    Ok(receipt.paid_cents == paid_cents && receipt.signature == sig)
 }
