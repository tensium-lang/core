+
+/// Whether a webhook payload is genuine, as one word.
+pub fn webhook_status(invoice_id: i64, paid_cents: i64, signature: &str) -> String {
+    match rpc::<bool>("verifyWebhook", &[json!(invoice_id), json!(paid_cents), json!(signature)]) {
+        Ok(true) => "genuine".to_string(),
+        Ok(false) => "forged".to_string(),
+        Err(e) => format!("error: {}", e),
+    }
+}
