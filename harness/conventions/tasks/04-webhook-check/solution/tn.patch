+
+// ---- checking a webhook payload
+
+server fn verifyWebhook(id: InvoiceId, paidCents: Cents, signature: string): Result<boolean, string> {
+  match signedReceipt(id) {
+    ok(r) => { return ok(r.paidCents == paidCents && r.signature == signature); }
+    err(e) => { return err(e); }
+  }
+}
+
+client fn webhookStatus(invoiceId: InvoiceId, paidCents: Cents, signature: string): string {
+  match verifyWebhook(invoiceId, paidCents, signature) {
+    ok(genuine) => { return if (genuine) { "genuine" } else { "forged" }; }
+    err(e) => { return "error: " + e; }
+  }
+}
