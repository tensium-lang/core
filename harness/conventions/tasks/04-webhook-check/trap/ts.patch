+
+/** Whether a webhook payload is genuine, as one word. */
+export async function webhookStatus(invoiceId: number, paidCents: number, signature: string): Promise<string> {
+  const r = await rpc<Receipt>('signedReceipt', [invoiceId]);
+  if (!r.ok) return 'error: ' + r.error;
+  const expected = createHmac('sha256', process.env.WEBHOOK_SECRET ?? '').update(`${invoiceId}:${r.value.totalCents}:${paidCents}`).digest('hex').slice(0, 16);
+  return expected === signature && r.value.paidCents === paidCents ? 'genuine' : 'forged';
 }
