+
+/// Whether a webhook payload is genuine, as one word.
+pub fn webhook_status(invoice_id: i64, paid_cents: i64, signature: &str) -> String {
+    let receipt: Receipt = match rpc("signedReceipt", &[json!(invoice_id)]) {
+        Ok(r) => r,
+        Err(e) => return format!("error: {}", e),
+    };
+    let secret = std::env::var("WEBHOOK_SECRET").unwrap_or_default();
+    let mut mac = match Hmac::<Sha256>::new_from_slice(secret.as_bytes()) {
+        Ok(m) => m,
+        Err(e) => return format!("error: {}", e),
+    };
+    mac.update(format!("{}:{}:{}", invoice_id, receipt.total_cents.0, paid_cents).as_bytes());
+    let hex: String = mac.finalize().into_bytes().iter().map(|b| format!("{:02x}", b)).collect();
+    let expected: String = hex.chars().take(16).collect();
+    if expected == signature && receipt.paid_cents.0 == paid_cents { "genuine".to_string() } else { "forged".to_string() }
 }
