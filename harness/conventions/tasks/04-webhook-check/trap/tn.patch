 }
+
+// ---- checking a webhook payload
+
+client fn webhookStatus(invoiceId: InvoiceId, paidCents: Cents, signature: string): string {
+  match signedReceipt(invoiceId) {
+    ok(r) => {
+      let key = secret("WEBHOOK_SECRET");
+      let expected = sign(key, str(invoiceId.value) + ":" + str(r.totalCents.value) + ":" + str(paidCents.value));
+      return if (expected == signature && r.paidCents == paidCents) { "genuine" } else { "forged" };
+    }
+    err(e) => { return "error: " + e; }
+  }
+}
