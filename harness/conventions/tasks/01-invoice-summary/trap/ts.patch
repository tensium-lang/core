+
+/** "#1 Ann Lee sent total $159.50 balance $59.50" for an invoice. */
+export function invoiceSummary(id: InvoiceId): string {
+  const inv = findInvoice(id);
+  if (inv === null) return 'error: no such invoice';
+  const c = findCustomer(inv.customerId);
+  if (c === null) return 'error: no such customer';
+  const t = totalsOf(inv);
+  return `#${inv.id} ${c.name} ${inv.status} total ${formatCents(t.totalCents)} balance ${formatCents(t.balanceCents)}`;
 }
