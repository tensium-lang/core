+
+// ---- invoice summary
+
+server fn invoiceSummary(id: InvoiceId): string {
+  let inv = findInvoice(id);
+  if (inv === null) { return "error: no such invoice"; }
+  let c = findCustomer(inv.customerId);
+  if (c === null) { return "error: no such customer"; }
+  let t = totalsOf(inv);
+  return "#" + str(inv.id.value) + " " + c.name + " " + statusWord(inv.status) + " total " + formatCents(t.totalCents) + " balance " + formatCents(t.balanceCents);
+}
+
+client fn summaryLine(invoiceId: InvoiceId): string {
+  return invoiceSummary(invoiceId);
+}
