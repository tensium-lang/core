+
+/// "#1 Ann Lee sent total $159.50 balance $59.50" for an invoice.
+pub fn invoice_summary(id: InvoiceId) -> Result<String, String> {
+    let inv = get_invoice(id)?;
+    let c = find_customer(inv.customer_id).ok_or_else(|| "no such customer".to_string())?;
+    let t = totals_of(&inv);
+    let status = match inv.status() {
+        Status::Draft => "draft",
+        Status::Sent => "sent",
+        Status::Paid => "paid",
+        Status::Void => "void",
+    };
+    Ok(format!("#{} {} {} total {} balance {}", inv.id.0, c.name, status, format_cents(t.total_cents), format_cents(t.balance_cents)))
 }
