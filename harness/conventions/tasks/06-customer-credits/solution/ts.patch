@@ -32,3 +32,13 @@
   if (!c.ok) return 'error: ' + c.error;
   return `${c.value.name} <${c.value.email}>`;
 }
+
+/** "Credits for Fay Wu: #7 $4.29" for a customer. */
+export async function creditSummary(customerId: number): Promise<string> {
+  const c = await rpc<Customer>('getCustomer', [customerId]);
+  if (!c.ok) return 'error: ' + c.error;
+  const credits = await rpc<{ invoiceId: number; creditCents: number }[]>('customerCredits', [customerId]);
+  if (!credits.ok) return 'error: ' + credits.error;
+  if (credits.value.length === 0) return `Credits for ${c.value.name}: none`;
+  return `Credits for ${c.value.name}: ${credits.value.map((e) => `#${e.invoiceId} ${formatCents(e.creditCents)}`).join(', ')}`;
+}
diff -ruN -x target -x bin -x out app/server/credits.ts ts/server/credits.ts
--- a/server/credits.ts	2026-10-10 11:47:05
+++ b/server/credits.ts	2026-10-10 12:24:28
@@ -2,7 +2,7 @@
 // goods, late delivery and so on), and the total credited on an invoice.
 
 import type { Cents, CreditNote, CustomerId, InvoiceId, Result } from '../shared/types.ts';
-import { invoiceBelongsTo } from './customers.ts';
+import { customerInvoices, invoiceBelongsTo } from './customers.ts';
 import { CREDIT_NOTES, findInvoice } from './data.ts';
 import { sumCents } from './lib/money.ts';
 import { err, ok } from './lib/result.ts';
@@ -20,4 +20,19 @@
 export function creditTotal(customerId: CustomerId, invoiceId: InvoiceId): Result<Cents, string> {
   if (!invoiceBelongsTo(invoiceId, customerId)) return err('invoice does not belong to customer');
   return ok(sumCents(CREDIT_NOTES.filter((c) => c.invoiceId === invoiceId).map((c) => c.amountCents)));
+}
+
+export type CreditSummaryEntry = { invoiceId: InvoiceId; creditCents: Cents };
+
+/** For each of a customer's invoices that has credit notes: the invoice and the total credited. */
+export function customerCredits(customerId: CustomerId): Result<CreditSummaryEntry[], string> {
+  const invoices = customerInvoices(customerId);
+  if (!invoices.ok) return invoices;
+  const out: CreditSummaryEntry[] = [];
+  for (const inv of invoices.value) {
+    const total = creditTotal(customerId, inv.id);
+    if (!total.ok) return total;
+    if (total.value !== 0) out.push({ invoiceId: inv.id, creditCents: total.value });
+  }
+  return ok(out);
 }
