+/// "Credits for Fay Wu: #7 $4.29" for a customer.
+pub fn credit_summary(customer_id: i64) -> String {
+    let c: Customer = match rpc("getCustomer", &[json!(customer_id)]) {
+        Ok(v) => v,
+        Err(e) => return format!("error: {}", e),
+    };
+    let credits: Vec<CreditSummaryEntry> = match rpc("customerCredits", &[json!(customer_id)]) {
+        Ok(v) => v,
+        Err(e) => return format!("error: {}", e),
+    };
+    if credits.is_empty() {
+        return format!("Credits for {}: none", c.name);
+    }
+    let parts: Vec<String> = credits.iter().map(|e| format!("#{} {}", e.invoice_id.0, format_cents(e.credit_cents))).collect();
