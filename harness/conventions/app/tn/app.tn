server fn creditNotes(): List<CreditNote> {
  return [
    { id: 1, invoiceId: InvoiceId(7), amountCents: Cents(429), reason: "damaged stickers" },
    { id: 2, invoiceId: InvoiceId(8), amountCents: Cents(5000), reason: "late delivery" },
  ];
}

server fn findCustomer(id: CustomerId): Customer | null {
  for (c in customers()) { if (c.id == id) { return c; } }
  return null;
}

server fn findProduct(id: ProductId): Product | null {
  for (p in products()) { if (p.id == id) { return p; } }
  return null;
}

server fn findInvoice(id: InvoiceId): Invoice | null {
  for (i in invoices()) { if (i.id == id) { return i; } }
  return null;
}

// ---- invoices: what they add up to, when they are due, and the one place a status may change

// Sales tax, in basis points: 8%. Charged on taxable products only.
fn taxBasisPoints(): number { return 800; }

server fn getInvoice(id: InvoiceId): Result<Invoice, string> {
  let inv = findInvoice(id);
  if (inv === null) { return err("no such invoice"); }
  return ok(inv);
}

server fn subtotalOf(inv: Invoice): Cents {
  let mut total = Cents(0);
  for (l in inv.lines) { total = addCents(total, timesCents(l.unitCents, l.quantity)); }
  return total;
}

// The part of the subtotal that tax applies to: lines whose product is taxable.
server fn taxableSubtotalOf(inv: Invoice): Cents {
  let mut total = Cents(0);
  for (l in inv.lines) {
    let p = findProduct(l.productId);
    if (p !== null) {
      if (p.taxable) { total = addCents(total, timesCents(l.unitCents, l.quantity)); }
    }
  }
  return total;
}

server fn paidOn(id: InvoiceId): Cents {
  let mut total = Cents(0);
  for (p in payments()) { if (p.invoiceId == id) { total = addCents(total, p.amountCents); } }
  return total;
}

server fn creditedOn(id: InvoiceId): Cents {
  let mut total = Cents(0);
  for (c in creditNotes()) { if (c.invoiceId == id) { total = addCents(total, c.amountCents); } }
  return total;
}

server fn totalsOf(inv: Invoice): Totals {
  let subtotalCents = subtotalOf(inv);
  let discountCents = percentOf(subtotalCents, inv.discountPercent * 100);
  let taxCents = percentOf(taxableSubtotalOf(inv), taxBasisPoints());
  let totalCents = addCents(subCents(subtotalCents, discountCents), taxCents);
  let paidCents = paidOn(inv.id);
  let creditCents = creditedOn(inv.id);
  return { subtotalCents: subtotalCents, discountCents: discountCents, taxCents: taxCents, totalCents: totalCents, paidCents: paidCents, creditCents: creditCents, balanceCents: subCents(subCents(totalCents, paidCents), creditCents) };
}

server fn invoiceTotals(id: InvoiceId): Result<Totals, string> {
  let inv = findInvoice(id);
  if (inv === null) { return err("no such invoice"); }
  return ok(totalsOf(inv));
}

// The day payment is due: the customer's terms counted from the day the invoice was issued.
server fn dueOn(inv: Invoice): Result<string, string> {
  let c = findCustomer(inv.customerId);
  if (c === null) { return err("no such customer"); }
  return ok(addDays(inv.issuedOn, c.termsDays));
}

// Days past due as of today, or 0 if not overdue (only sent invoices can be overdue).
server fn daysOverdue(inv: Invoice): Result<number, string> {
  if (inv.status != Status.Sent) { return ok(0); }
  match dueOn(inv) {
    ok(due) => {
      if (!isAfter(today(), due)) { return ok(0); }
      return ok(daysBetween(due, today()));
    }
    err(e) => { return err(e); }
  }
}

// Moves an invoice to its next status and stamps the date. This is the only place a status may
// change: it refuses moves the business does not allow (paying a void invoice, sending a paid one, ...).
server fn transition(inv: Invoice, next: Status): Result<Invoice, string> {
  if (inv.status == Status.Paid) { return err("invoice is already paid"); }
  if (inv.status == Status.Void) { return err("invoice is void"); }
  match next {
    Draft => { return err("an invoice cannot go back to draft"); }
    Sent => {
      if (inv.status == Status.Sent) { return err("invoice is already sent"); }
      return ok({ ...inv, status: Status.Sent, sentOn: today() });
    }
    Paid => {
      if (inv.status == Status.Draft) { return err("a draft invoice cannot be paid"); }
      return ok({ ...inv, status: Status.Paid, paidOn: today() });
    }
    Void => { return ok({ ...inv, status: Status.Void }); }
  }
}

// Checks that a draft invoice is complete enough to be sent to the customer.
server fn readyToSend(inv: Invoice): Result<boolean, string> {
  if (len(inv.lines) == 0) { return err("invoice has no lines"); }
  for (l in inv.lines) {
    if (l.quantity < 1) { return err("line quantity must be at least 1"); }
    if (findProduct(l.productId) === null) { return err("line refers to an unknown product"); }
  }
  let c = findCustomer(inv.customerId);
  if (c === null) { return err("no such customer"); }
  if (c.email == "") { return err("customer has no email address"); }
  return ok(true);
}

// ---- customers and products

server fn getCustomer(id: CustomerId): Result<Customer, string> {
  let c = findCustomer(id);
  if (c === null) { return err("no such customer"); }
  return ok(c);
}

server fn getProduct(id: ProductId): Result<Product, string> {
  let p = findProduct(id);
  if (p === null) { return err("no such product"); }
  return ok(p);
}

server fn customerInvoices(customerId: CustomerId): Result<List<Invoice>, string> {
  let c = findCustomer(customerId);
  if (c === null) { return err("no such customer"); }
  let mut out: List<Invoice> = [];
  for (i in invoices()) { if (i.customerId == customerId) { out = push(out, i); } }
  return ok(out);
}

// True when the invoice exists and belongs to the customer.
server fn invoiceBelongsTo(invoiceId: InvoiceId, customerId: CustomerId): boolean {
  let inv = findInvoice(invoiceId);
  if (inv === null) { return false; }
  return inv.customerId == customerId;
}

server fn listProducts(): Result<List<Product>, string> { return ok(products()); }

// Products whose name contains the text, ignoring case. An empty search is an error.
server fn searchProducts(text: string): Result<List<Product>, string> {
  let needle = toLower(trim(text));
  if (needle == "") { return err("search text is empty"); }
  let mut out: List<Product> = [];
  for (p in products()) { if (contains(toLower(p.name), needle)) { out = push(out, p); } }
  return ok(out);
}

server fn customersInRegion(region: string): Result<List<Customer>, string> {
  let mut out: List<Customer> = [];
  for (c in customers()) { if (c.region == region) { out = push(out, c); } }
  if (len(out) == 0) { return err("no customers in region " + region); }
  return ok(out);
}

// ---- payments and credit notes

server fn paymentsFor(id: InvoiceId): Result<List<Payment>, string> {
  let inv = findInvoice(id);
  if (inv === null) { return err("no such invoice"); }
  let mut out: List<Payment> = [];
  for (p in payments()) { if (p.invoiceId == id) { out = push(out, p); } }
  return ok(out);
}

// Whether a payment of this size could be taken on the invoice as it stands; gives the balance left after it.
server fn paymentAllowed(id: InvoiceId, amountCents: Cents): Result<Cents, string> {
  let inv = findInvoice(id);
  if (inv === null) { return err("no such invoice"); }
  if (inv.status == Status.Draft) { return err("invoice has not been sent"); }
  if (inv.status == Status.Void) { return err("invoice is void"); }
  if (inv.status == Status.Paid) { return err("invoice is already paid"); }
  if (amountCents.value <= 0) { return err("payment must be more than zero"); }
  let balance = totalsOf(inv).balanceCents;
  if (amountCents.value > balance.value) { return err("payment exceeds balance"); }
  return ok(subCents(balance, amountCents));
}

server fn creditsFor(id: InvoiceId): Result<List<CreditNote>, string> {
  let inv = findInvoice(id);
  if (inv === null) { return err("no such invoice"); }
  let mut out: List<CreditNote> = [];
  for (c in creditNotes()) { if (c.invoiceId == id) { out = push(out, c); } }
  return ok(out);
}

// The total credited on one of a customer's invoices. The customer id is checked first so a
// customer can only ever see credits on their own invoices.
server fn creditTotal(customerId: CustomerId, invoiceId: InvoiceId): Result<Cents, string> {
  if (!invoiceBelongsTo(invoiceId, customerId)) { return err("invoice does not belong to customer"); }
  return ok(creditedOn(invoiceId));
}

// ---- reminders and signed receipts

server fn reminderText(id: InvoiceId): Result<string, string> {
  let inv = findInvoice(id);
  if (inv === null) { return err("no such invoice"); }
  if (inv.status != Status.Sent) { return err("only a sent invoice can be reminded"); }
  let c = findCustomer(inv.customerId);
  if (c === null) { return err("no such customer"); }
  match dueOn(inv) {
    ok(due) => {
      match daysOverdue(inv) {
        ok(late) => {
          let balance = formatCents(totalsOf(inv).balanceCents);
          if (late == 0) {
            return ok("To: " + c.email + "\nHello " + c.name + ", invoice #" + str(inv.id.value) + " for " + balance + " is due on " + due + ".");
          }
          return ok("To: " + c.email + "\nHello " + c.name + ", invoice #" + str(inv.id.value) + " for " + balance + " was due on " + due + " and is " + str(late) + " days overdue.");
        }
        err(e) => { return err(e); }
      }
    }
    err(e) => { return err(e); }
  }
}

// A receipt for a sent or paid invoice, signed as "<invoice id>:<total>:<paid>" with the webhook secret.
server fn signedReceipt(id: InvoiceId): Result<Receipt, string> {
  let inv = findInvoice(id);
  if (inv === null) { return err("no such invoice"); }
  if (inv.status == Status.Draft) { return err("invoice has not been sent"); }
  if (inv.status == Status.Void) { return err("invoice is void"); }
  let t = totalsOf(inv);
  let key = secret("WEBHOOK_SECRET");
  let signature = sign(key, str(inv.id.value) + ":" + str(t.totalCents.value) + ":" + str(t.paidCents.value));
  return ok({ invoiceId: inv.id, totalCents: t.totalCents, paidCents: t.paidCents, signature: signature });
}

// ---- reports

server fn dashboardStats(): Result<Stats, string> {
  let mut draft = 0;
  let mut sent = 0;
  let mut paid = 0;
  let mut voided = 0;
  let mut outstanding = Cents(0);
  for (inv in invoices()) {
    match inv.status {
      Draft => { draft = draft + 1; }
      Sent => {
        sent = sent + 1;
        outstanding = addCents(outstanding, totalsOf(inv).balanceCents);
      }
      Paid => { paid = paid + 1; }
      Void => { voided = voided + 1; }
    }
  }
  return ok({ draft: draft, sent: sent, paid: paid, void: voided, outstandingCents: outstanding });
}

// Sent invoices past their due date, oldest due date first.
server fn overdueInvoices(): Result<List<OverdueEntry>, string> {
  let mut found: List<OverdueEntry> = [];
  for (inv in invoices()) {
    match daysOverdue(inv) {
      ok(late) => {
        if (late > 0) {
          match dueOn(inv) {
            ok(due) => {
              let c = findCustomer(inv.customerId);
              if (c === null) { return err("no such customer"); }
              found = push(found, { invoiceId: inv.id, customerName: c.name, dueOn: due, daysOverdue: late, balanceCents: totalsOf(inv).balanceCents });
            }
            err(e) => { return err(e); }
          }
        }
      }
      err(e) => { return err(e); }
    }
  }
  // sort by due date: pick the earliest not yet taken, one at a time
  let mut sorted: List<OverdueEntry> = [];
  let mut taken: List<number> = [];
  for (step in range(0, len(found))) {
    let mut best: OverdueEntry | null = null;
    for (e in found) {
      if (!has(taken, e.invoiceId.value)) {
        if (best === null) { best = e; }
        else if (e.dueOn < best.dueOn) { best = e; }
      }
    }
    if (best !== null) {
      sorted = push(sorted, best);
      taken = push(taken, best.invoiceId.value);
    }
  }
  return ok(sorted);
}

server fn agingReport(): Result<AgingBuckets, string> {
  let mut current = Cents(0);
  let mut d1 = Cents(0);
  let mut d31 = Cents(0);
  let mut d61 = Cents(0);
  let mut over = Cents(0);
  for (inv in invoices()) {
    if (inv.status == Status.Sent) {
      match daysOverdue(inv) {
        ok(late) => {
          let balance = totalsOf(inv).balanceCents;
          if (late == 0) { current = addCents(current, balance); }
          else if (late <= 30) { d1 = addCents(d1, balance); }
          else if (late <= 60) { d31 = addCents(d31, balance); }
          else if (late <= 90) { d61 = addCents(d61, balance); }
          else { over = addCents(over, balance); }
        }
        err(e) => { return err(e); }
      }
    }
  }
  return ok({ current: current, days1to30: d1, days31to60: d31, days61to90: d61, over90: over });
}

// ---- client: text for each screen

fn statusWord(s: Status): string {
  return match s {
    Draft => "draft",
    Sent => "sent",
    Paid => "paid",
    Void => "void",
  };
}

fn discountNote(percent: number): string {
  if (percent == 0) { return ""; }
  return " (" + str(percent) + "% off)";
}

client fn invoiceView(invoiceId: InvoiceId): string {
  match getInvoice(invoiceId) {
    ok(inv) => {
      match getCustomer(inv.customerId) {
        ok(cust) => {
          match invoiceTotals(invoiceId) {
            ok(t) => {
              let mut lines: List<string> = [];
              lines = push(lines, "Invoice #" + str(inv.id.value) + " for " + cust.name);
              lines = push(lines, "Status: " + statusWord(inv.status));
              lines = push(lines, "Issued: " + inv.issuedOn);
              for (l in inv.lines) {
                let name = match getProduct(l.productId) {
                  ok(p) => p.name,
                  err(e) => "product #" + str(l.productId.value),
                };
                lines = push(lines, "  " + str(l.quantity) + " x " + name + " @ " + formatCents(l.unitCents) + " = " + formatCents(timesCents(l.unitCents, l.quantity)));
              }
              lines = push(lines, "Subtotal: " + formatCents(t.subtotalCents));
              if (t.discountCents.value != 0) { lines = push(lines, "Discount" + discountNote(inv.discountPercent) + ": -" + formatCents(t.discountCents)); }
              lines = push(lines, "Tax: " + formatCents(t.taxCents));
              lines = push(lines, "Total: " + formatCents(t.totalCents));
              if (t.paidCents.value != 0) { lines = push(lines, "Paid: " + formatCents(t.paidCents)); }
              if (t.creditCents.value != 0) { lines = push(lines, "Credits: " + formatCents(t.creditCents)); }
              lines = push(lines, "Balance: " + formatCents(t.balanceCents));
              if (inv.notes !== null) { lines = push(lines, "Notes: " + inv.notes); }
              return join(lines, "\n");
            }
            err(e) => { return "error: " + e; }
          }
        }
        err(e) => { return "error: " + e; }
      }
    }
    err(e) => { return "error: " + e; }
  }
}

// One line per product: "Widget - $12.50" with "(taxable)" when tax applies.
client fn productLabel(productId: ProductId): string {
  match getProduct(productId) {
    ok(p) => {
      let tax = if (p.taxable) { " (taxable)" } else { "" };
      return p.name + " - " + formatCents(p.unitCents) + tax;
    }
    err(e) => { return "error: " + e; }
  }
}

// The signed receipt for an invoice, as one line.
client fn receiptLine(invoiceId: InvoiceId): string {
  match signedReceipt(invoiceId) {
    ok(r) => { return "Receipt #" + str(r.invoiceId.value) + ": total " + formatCents(r.totalCents) + ", paid " + formatCents(r.paidCents) + " [" + r.signature + "]"; }
    err(e) => { return "error: " + e; }
  }
}

// The reminder email the server would send, as text.
client fn reminderPreview(invoiceId: InvoiceId): string {
  match reminderText(invoiceId) {
    ok(text) => { return text; }
    err(e) => { return "error: " + e; }
  }
}

client fn customerView(customerId: CustomerId): string {
  match getCustomer(customerId) {
    ok(c) => {
      match customerInvoices(customerId) {
        ok(invs) => {
          let mut lines: List<string> = [];
          lines = push(lines, c.name + " <" + c.email + ">");
          lines = push(lines, "Terms: net " + str(c.termsDays));
          lines = push(lines, "Region: " + c.region);
          let mut owed = Cents(0);
          for (inv in invs) {
            match invoiceTotals(inv.id) {
              ok(t) => {
                let balance = if (inv.status == Status.Sent) { t.balanceCents } else { Cents(0) };
                owed = addCents(owed, balance);
                lines = push(lines, "  #" + str(inv.id.value) + " " + inv.issuedOn + " " + statusWord(inv.status) + " total " + formatCents(t.totalCents) + " balance " + formatCents(balance));
              }
              err(e) => { return "error: " + e; }
            }
          }
          lines = push(lines, "Outstanding: " + formatCents(owed));
          return join(lines, "\n");
        }
        err(e) => { return "error: " + e; }
      }
    }
    err(e) => { return "error: " + e; }
  }
}

// "Ann Lee <ann@example.com>" for a customer.
client fn contactLine(customerId: CustomerId): string {
  match getCustomer(customerId) {
    ok(c) => { return c.name + " <" + c.email + ">"; }
    err(e) => { return "error: " + e; }
  }
}

client fn dashboardView(): string {
  match dashboardStats() {
    ok(v) => {
      return "Draft: " + str(v.draft) + "\nSent: " + str(v.sent) + "\nPaid: " + str(v.paid) + "\nVoid: " + str(v.void) + "\nOutstanding: " + formatCents(v.outstandingCents);
    }
    err(e) => { return "error: " + e; }
  }
}

client fn overdueView(): string {
  match overdueInvoices() {
    ok(entries) => {
      if (len(entries) == 0) { return "Nothing overdue"; }
      let mut lines: List<string> = [];
      for (e in entries) {
        lines = push(lines, "#" + str(e.invoiceId.value) + " " + e.customerName + ": " + formatCents(e.balanceCents) + " due " + e.dueOn + ", " + str(e.daysOverdue) + " days overdue");
      }
      return join(lines, "\n");
    }
    err(e) => { return "error: " + e; }
  }
}

client fn catalogView(): string {
  match listProducts() {
    ok(ps) => {
      let mut lines: List<string> = [];
      for (p in ps) {
        let tax = if (p.taxable) { " (taxable)" } else { "" };
        lines = push(lines, p.name + " - " + formatCents(p.unitCents) + tax);
      }
      return join(lines, "\n");
    }
    err(e) => { return "error: " + e; }
  }
}

client fn searchView(text: string): string {
  match searchProducts(text) {
    ok(ps) => {
      if (len(ps) == 0) { return "No products match"; }
      let mut lines: List<string> = [];
      for (p in ps) { lines = push(lines, p.name + " - " + formatCents(p.unitCents)); }
      return join(lines, "\n");
    }
    err(e) => { return "error: " + e; }
  }
}

client fn regionView(region: string): string {
  match customersInRegion(region) {
    ok(cs) => {
      let mut lines: List<string> = [];
      for (c in cs) { lines = push(lines, c.name + " (net " + str(c.termsDays) + ")"); }
      return join(lines, "\n");
    }
    err(e) => { return "error: " + e; }
  }
}

client fn agingView(): string {
  match agingReport() {
    ok(b) => {
      return "Current: " + formatCents(b.current) + "\n1-30 days: " + formatCents(b.days1to30) + "\n31-60 days: " + formatCents(b.days31to60) + "\n61-90 days: " + formatCents(b.days61to90) + "\nOver 90 days: " + formatCents(b.over90);
    }
    err(e) => { return "error: " + e; }
  }
}
