    { invoiceId: InvoiceId(11), amountCents: Cents(60000), receivedOn: "2026-04-10", method: "card" },
    { invoiceId: InvoiceId(12), amountCents: Cents(461), receivedOn: "2026-09-01", method: "cash" },
