// A small invoicing app with two halves in one file. The server half knows the customers,
// products, invoices, payments and credit notes, works out what each invoice adds up to and when
// it is due, writes reminder messages, and signs receipts with a secret. The client half asks the
// server for all of that and turns it into the lines of text a person sees on each screen.
// Both halves share the same record types, so they can never disagree about what an invoice is.

// ---- the kinds of value the app talks about

newtype Cents = number;
newtype CustomerId = number;
newtype ProductId = number;
newtype InvoiceId = number;

enum Status { Draft, Sent, Paid, Void }

type Customer = { id: CustomerId, name: string, email: string, phone: string | null, termsDays: number, region: string }
type Product = { id: ProductId, name: string, unitCents: Cents, taxable: boolean }
type LineItem = { productId: ProductId, quantity: number, unitCents: Cents }
type Invoice = { id: InvoiceId, customerId: CustomerId, issuedOn: string, status: Status, lines: List<LineItem>, discountPercent: number, notes: string | null, sentOn: string | null, paidOn: string | null }
type Payment = { invoiceId: InvoiceId, amountCents: Cents, receivedOn: string, method: string }
type CreditNote = { id: number, invoiceId: InvoiceId, amountCents: Cents, reason: string }
type Totals = { subtotalCents: Cents, discountCents: Cents, taxCents: Cents, totalCents: Cents, paidCents: Cents, creditCents: Cents, balanceCents: Cents }
type OverdueEntry = { invoiceId: InvoiceId, customerName: string, dueOn: string, daysOverdue: number, balanceCents: Cents }
type Stats = { draft: number, sent: number, paid: number, void: number, outstandingCents: Cents }
type Receipt = { invoiceId: InvoiceId, totalCents: Cents, paidCents: Cents, signature: string }
type AgingBuckets = { current: Cents, days1to30: Cents, days31to60: Cents, days61to90: Cents, over90: Cents }

// ---- money (shared): whole cents only; every percentage goes through percentOf

// basisPoints of amount (100 basis points = 1%), rounding halves to the nearest even cent.
fn percentOf(amount: Cents, basisPoints: number): Cents {
  let numerator = amount.value * basisPoints;
  let negative = numerator < 0;
  let n = abs(numerator);
  let whole = floor(n / 10000);
  let remainder = n - whole * 10000;
  let twice = remainder * 2;
  let mut r = whole;
  if (twice > 10000) { r = whole + 1; }
  if (twice == 10000) {
    if (whole % 2 == 1) { r = whole + 1; }
  }
  if (negative) { return Cents(0 - r); }
  return Cents(r);
}

fn addCents(a: Cents, b: Cents): Cents { return Cents(a.value + b.value); }

fn subCents(a: Cents, b: Cents): Cents { return Cents(a.value - b.value); }

fn timesCents(unit: Cents, quantity: number): Cents { return Cents(unit.value * quantity); }

fn twoDigits(n: number): string {
  if (n < 10) { return "0" + str(n); }
  return str(n);
}

fn formatCents(cents: Cents): string {
  let sign = if (cents.value < 0) { "-" } else { "" };
  let a = abs(cents.value);
  return sign + "$" + str(floor(a / 100)) + "." + twoDigits(a % 100);
}

// ---- dates (shared): "YYYY-MM-DD" text turned into a count of days and back, with whole numbers

fn digits(s: string): number {
  return match parseInt(s) {
    ok(n) => n,
    err(e) => 0,
  };
}

fn toDays(iso: string): number {
  let y0 = digits(substring(iso, 0, 4));
  let m = digits(substring(iso, 5, 7));
  let d = digits(substring(iso, 8, 10));
  let y = if (m <= 2) { y0 - 1 } else { y0 };
  let era = floor(y / 400);
  let yoe = y - era * 400;
  let mp = (m + 9) % 12;
  let doy = floor((153 * mp + 2) / 5) + d - 1;
  let doe = yoe * 365 + floor(yoe / 4) - floor(yoe / 100) + doy;
  return era * 146097 + doe - 719468;
}

fn fromDays(days: number): string {
  let z = days + 719468;
  let era = floor(z / 146097);
  let doe = z - era * 146097;
  let yoe = floor((doe - floor(doe / 1460) + floor(doe / 36524) - floor(doe / 146096)) / 365);
  let doy = doe - (365 * yoe + floor(yoe / 4) - floor(yoe / 100));
  let mp = floor((5 * doy + 2) / 153);
  let d = doy - floor((153 * mp + 2) / 5) + 1;
  let m = if (mp < 10) { mp + 3 } else { mp - 9 };
  let y = yoe + era * 400 + (if (m <= 2) { 1 } else { 0 });
  return str(y) + "-" + twoDigits(m) + "-" + twoDigits(d);
}

fn addDays(iso: string, days: number): string { return fromDays(toDays(iso) + days); }

fn daysBetween(a: string, b: string): number { return toDays(b) - toDays(a); }

fn isAfter(a: string, b: string): boolean { return toDays(a) > toDays(b); }

// ---- the server's idea of today, fixed so every run comes out the same

fn today(): string { return "2026-10-01"; }

// ---- the server's data: a fixed set that stands in for a database

