function half(n) {
  if (n < 0) { throw "neg"; }
  return n / 2;
}

fn run(s: string): Result<number, string> {
  parseInt(s);
  let x: number = parseInt(s) + 1;
  return match parseInt(s) {
    ok(n) => ok(n),
  };
}

fn nul(s: string | null): number {
  return len(s);
}
